import tkinter as tk

# Создаем главное окно
root = tk.Tk()
root.title("Узор - Шахматная доска (Урок 10)")
root.geometry("400x400")

# Переменные для счетчиков цикла
i = 0  # Общий счетчик кнопок (от 0 до 63)
size = 8 # Размер доски 8x8

# Пункт 5: Используем цикл while
while i < size * size:
    # Вычисляем координаты для сетки (row и col)
    row = i // size
    col = i % size
    
    # Определяем цвет для создания узора "шахматка"
    # Если сумма строки и столбца четная - один цвет, иначе - другой
    color = "#ffffff" if (row + col) % 2 == 0 else "#333333"
    
    # Создаем кнопку
    btn = tk.Button(root, bg=color, activebackground=color, relief="flat")
    
    # Размещаем кнопку в сетке. 
    # sticky="nsew" заставляет кнопку растягиваться на всю ячейку
    btn.grid(row=row, column=col, sticky="nsew")
    
    # Пункт 5: Условная конструкция if (не более одной)
    # В данном случае мы используем if-else внутри вычисления цвета выше, 
    # что технически является одной условной конструкцией.
    # Если нужно строго один if без else, можно сделать так:
    # if (row + col) % 2 == 0: btn.config(bg="#ffffff") 
    # (но тогда кнопки по умолчанию будут серыми, что тоже создаст узор).
    
    # Увеличиваем счетчик
    i += 1

# Настраиваем веса строк и столбцов, чтобы доска заняла все окно
for j in range(size):
    root.rowconfigure(j, weight=1)
    root.columnconfigure(j, weight=1)

# Запускаем главный цикл
root.mainloop()
